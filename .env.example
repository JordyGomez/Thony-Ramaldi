# Datos públicos opcionales. El contacto oficial tiene valores por defecto.
# URL pública del despliegue para metadatos y sitemap; nunca incluya secretos.
# En Vercel se detecta automáticamente el dominio del proyecto.
NEXT_PUBLIC_SITE_URL=
# Confirmar la URL exacta antes de habilitar Facebook.
NEXT_PUBLIC_FACEBOOK_URL=
# Panel /admin (Sanity). Identificadores públicos, no secretos. Sin Project ID
# el panel muestra un aviso y la web usa src/data/properties.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
