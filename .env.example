# Datos públicos opcionales. El contacto oficial tiene valores por defecto.
# URL pública del despliegue para metadatos y sitemap; nunca incluya secretos.
# En Vercel se detecta automáticamente el dominio del proyecto.
NEXT_PUBLIC_SITE_URL=
# Panel /admin (Supabase). El proyecto oficial ya está como valor por defecto
# en src/lib/supabase/env.ts (URL y clave publishable son públicas). Definirlas
# solo para usar otro proyecto; dejarlas VACÍAS desactiva Supabase y deja el
# catálogo vacío. Las fixtures de tests requieren THONY_TEST_FIXTURES=1 fuera
# de Vercel; no configurar esa variable en despliegues públicos.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: solo antes de habilitar incorporación empresarial autorizada.
# Clave PÚBLICA de Turnstile; el secreto se configura en Supabase Auth.
# Requiere conectar el hook Before User Created y confirmar correo en Supabase.
# NEXT_PUBLIC_AUTH_CAPTCHA_SITE_KEY=

# Agenda privada de Thony: configurar SOLO tras instalar SQL y autorizar su UID.
# Turnstile de reservas (distinto de la configuración de Supabase Auth).
# NEXT_PUBLIC_APPOINTMENTS_CAPTCHA_SITE_KEY=
# APPOINTMENTS_TURNSTILE_SECRET=
# Secretos diferentes, aleatorios, de al menos 32 bytes. Nunca NEXT_PUBLIC.
# APPOINTMENTS_SERVER_SECRET=
# APPOINTMENTS_LINK_SIGNING_SECRET=
# Opcional; por defecto se usa el dominio actual de site.ts.
# APPOINTMENTS_PUBLIC_ORIGIN=https://thony-ramaldi.vercel.app

# Correo transaccional: no se envía hasta verificar este dominio con Resend.
# RESEND_API_KEY=
# RESEND_DOMAIN_ID=
# APPOINTMENTS_EMAIL_FROM=
# RESEND_WEBHOOK_SECRET=

# WhatsApp Cloud API oficial: versión compatible indicada en tu app de Meta.
# Remitente verificado DIFERENTE del WhatsApp destinatario de Thony.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=
# WHATSAPP_TEMPLATE_OWNER=
# WHATSAPP_TEMPLATE_CLIENT=
# WHATSAPP_TEMPLATE_LANGUAGE=es
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
